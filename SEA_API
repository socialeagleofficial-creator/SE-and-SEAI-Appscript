const SE_SHEET_ID   = '1jCJnYqbHM4Ymrk8-Sp4AwK-XOhRmNroIoFd1GbJmQoM';
const SEAI_SHEET_ID = '1mBYUJ2QECvYrH6ALdVel1qSM7oRyrMfPdnjeJbDWzNY';
const API_SECRET    = 'SEA_DASH_2026_SECRET';
const SESSION_HOURS = 8;

// ── Entry point ───────────────────────────────────────────
function doGet(e) {
  const params  = e.parameter;
  const action  = params.action || '';
  const secret  = params.secret || '';
  const token   = params.token  || '';

  const res = ContentService.createTextOutput();
  res.setMimeType(ContentService.MimeType.JSON);

  try {
    if (action === 'login') {
      res.setContent(JSON.stringify(handleLogin(params)));
    } else if (action === 'data') {
      if (!validateToken(token)) {
        res.setContent(JSON.stringify({ error: 'Unauthorised' }));
      } else {
        res.setContent(JSON.stringify(handleData()));
      }
    } else if (action === 'setup') {
      if (secret !== API_SECRET) {
        res.setContent(JSON.stringify({ error: 'Forbidden' }));
      } else {
        ensureUsersTab();
        res.setContent(JSON.stringify({ ok: true, message: 'SEA_Users tab ready' }));
      }
    } else {
      res.setContent(JSON.stringify({ error: 'Unknown action' }));
    }
  } catch(err) {
    res.setContent(JSON.stringify({ error: err.message }));
  }

  return res;
}

// ── Login handler ─────────────────────────────────────────
function handleLogin(params) {
  const email    = (params.email    || '').trim().toLowerCase();
  const passcode = (params.passcode || '').trim();

  if (!email || !passcode) return { ok: false, error: 'Missing credentials' };

  ensureUsersTab();

  const ss     = SpreadsheetApp.openById(SE_SHEET_ID);
  const sheet  = ss.getSheetByName('SEA_Users');
  const data   = sheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {
    const rowEmail    = String(data[i][0]).trim().toLowerCase();
    const rowPass     = String(data[i][1]).trim();
    const rowName     = String(data[i][2]).trim();
    const rowActive   = String(data[i][3]).trim().toUpperCase();

    if (rowEmail === email && rowPass === passcode && rowActive === 'TRUE') {
      const token = generateToken(email);
      saveToken(token, email);
      return { ok: true, token, name: rowName };
    }
  }

  return { ok: false, error: 'Invalid email or passcode' };
}

// ── Token helpers ─────────────────────────────────────────
function generateToken(email) {
  const rand = Math.random().toString(36).slice(2);
  const ts   = Date.now().toString(36);
  return rand + ts;
}

function saveToken(token, email) {
  const cache    = CacheService.getScriptCache();
  const expirySec = SESSION_HOURS * 3600;
  cache.put('token_' + token, email, expirySec);
}

function validateToken(token) {
  if (!token) return false;
  const cache = CacheService.getScriptCache();
  const email = cache.get('token_' + token);
  return !!email;
}

// ── Data handler ──────────────────────────────────────────
function handleData() {
  const seData   = readMasterSheet(SE_SHEET_ID,   'SE_Master',   'SE');
  const seaiData = readMasterSheet(SEAI_SHEET_ID, 'SEAI_Master', 'SEAI');
  const webinar  = readWebinarData(SEAI_SHEET_ID);
  const dm2dc    = readDM2DCData(SE_SHEET_ID);

  return {
    adSpend: [...seData, ...seaiData],
    webinar,
    dm2dc
  };
}

// ── Read master Sheet ─────────────────────────────────────
function readMasterSheet(sheetId, tabName, brand) {
  const ss    = SpreadsheetApp.openById(sheetId);
  const sheet = ss.getSheetByName(tabName);
  if (!sheet) return [];

  const rows    = sheet.getDataRange().getValues();
  if (rows.length < 2) return [];

  const headers = rows[0].map(h => String(h).trim());
  const result  = [];

  for (let i = 1; i < rows.length; i++) {
    const row = rows[i];
    const obj = {};
    headers.forEach((h, idx) => {
      obj[h] = row[idx];
    });
    if (!obj['Course'] || String(obj['Course']).toLowerCase() === 'total') continue;
    obj['Brand'] = brand;
    result.push(cleanRow(obj));
  }

  return result;
}

// ── Read webinar data ─────────────────────────────────────
function readWebinarData(sheetId) {
  const ss = SpreadsheetApp.openById(sheetId);
  const sheets = ss.getSheets();
  const result = [];

  sheets.forEach(sheet => {
    const name = sheet.getName();
    if (!name.toLowerCase().includes('webinar') && !name.toLowerCase().includes('wp') && !name.toLowerCase().includes('bo')) return;

    const rows = sheet.getDataRange().getValues();
    if (rows.length < 2) return;

    const headers = rows[0].map(h => String(h).trim());
    for (let i = 1; i < rows.length; i++) {
      const row = rows[i];
      const obj = { _tab: name };
      headers.forEach((h, idx) => { obj[h] = row[idx]; });
      if (!obj['Cohort'] && !obj['Date']) return;
      result.push(cleanRow(obj));
    }
  });

  return result;
}

// ── Read DM 2DC data (separate webinar course) ────────────
function readDM2DCData(sheetId) {
  const ss = SpreadsheetApp.openById(sheetId);
  const sheets = ss.getSheets();
  const result = [];

  sheets.forEach(sheet => {
    const name = sheet.getName();
    if (!name.toUpperCase().includes('2DC') && !name.toUpperCase().includes('DM 2DC')) return;

    const rows = sheet.getDataRange().getValues();
    if (rows.length < 2) return;

    const headers = rows[0].map(h => String(h).trim());
    for (let i = 1; i < rows.length; i++) {
      const row = rows[i];
      const obj = { _tab: name };
      headers.forEach((h, idx) => { obj[h] = row[idx]; });
      result.push(cleanRow(obj));
    }
  });

  return result;
}

// ── Clean row values (strip ₹, commas etc.) ───────────────
function cleanRow(obj) {
  const cleaned = {};
  Object.entries(obj).forEach(([k, v]) => {
    if (typeof v === 'string') {
      const num = parseFloat(v.replace(/[₹,\s%]/g, ''));
      cleaned[k] = isNaN(num) ? v : num;
    } else {
      cleaned[k] = v;
    }
  });
  return cleaned;
}

